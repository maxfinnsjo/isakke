# Optional: hosted free-tier models write the answers on the slim demo. Copy to ~/apps/isakke/.env on the VPS (deploy.sh creates an empty
# one and never uploads it) and fill in. Same variable names as skandinavetnyhets, so the key lines can be copied from its .env.
# Leave LLM_CHAIN out and the demo stays in search mode (the closest paragraphs, no generated text).
#
# Models are tried in order; one that answers 429 (quota) or 402 (not free) is skipped until its limit resets. Free models only:
# OpenRouter entries must end in :free, anything else is refused. Check the model names against skandinavetnyhets' LLM_CHAIN.
LLM_CHAIN=groq:openai/gpt-oss-120b,ollamacloud:gpt-oss:120b,openrouter:MODEL:free
LLM_API_KEY=            # Gemini (provider "gemini")
GROQ_API_KEY=
OLLAMA_API_KEY=
OPENROUTER_API_KEY=
# Free quotas are small: cap what the public demo may spend (AI answers per day, in total and per visitor).
LLM_DAILY_MAX=200
LLM_PER_IP_DAY=10
